{
  "GIN": {
    "model": {
      "config": {
        "model_name": "GIN",
        "node_dim": 64,
        "depth": 5,
        "units": 64,
        "dropout": 0.05,
        "use_edge_features": false,
        "node_pooling": "sum",
        "output_units": [
          64,
          32
        ],
        "num_targets": 1,
        "output_activation": "sigmoid"
      }
    },
    "training": {
      "fit": {
        "epochs": 300,
        "batch_size": 32,
        "early_stopping_patience": 50
      },
      "compile": {
        "optimizer": {
          "class_name": "Adam",
          "config": {
            "lr": 0.001
          }
        },
        "loss": "bce_with_logits"
      },
      "scheduler": {
        "class_name": "ReduceLROnPlateau",
        "patience": 25,
        "factor": 0.5,
        "min_lr": 1e-06
      },
      "cross_validation": {
        "n_splits": 5,
        "shuffle": true
      }
    },
    "data": {
      "dataset": {
        "class_name": "Mutagenicity",
        "config": {
          "root": "data/"
        }
      },
      "data_unit": ""
    }
  },
