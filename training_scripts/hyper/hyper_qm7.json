{
  "SchNet": {
    "model": {
      "config": {
        "model_name": "SchNet",
        "num_features": 128,
        "num_filters": 128,
        "num_interactions": 4,
        "cutoff": 4.0,
        "num_gaussians": 20,
        "readout": "sum",
        "output_dim": 1
      }
    },
    "training": {
      "fit": {
        "epochs": 800,
        "batch_size": 32,
        "early_stopping_patience": 100
      },
      "compile": {
        "optimizer": {
          "class_name": "Adam",
          "config": {
            "lr": 0.0005
          }
        },
        "loss": "mae"
      },
      "scheduler": {
        "class_name": "ReduceLROnPlateau",
        "patience": 50,
        "factor": 0.5,
        "min_lr": 1e-06
      },
      "scaler": {
        "class_name": "QMGraphLabelScaler"
      },
      "cross_validation": {
        "n_splits": 5,
        "shuffle": true
      }
    },
    "data": {
      "dataset": {
        "class_name": "QM7",
        "config": {
          "root": "data/"
        }
      },
      "data_unit": "kcal/mol"
    }
  },
