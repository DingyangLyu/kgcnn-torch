    }
  },
  "CGCNN": {
    "model": {
      "config": {
        "model_name": "CGCNN",
        "node_features": 64,
        "edge_features": 64,
        "depth": 4,
        "units": 128,
        "cutoff": 6.0,
        "num_gaussians": 60,
        "readout": "mean",
        "output_dim": 1
