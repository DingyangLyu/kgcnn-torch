{
  "GAT": {
    "model": {
      "config": {
        "model_name": "GAT",
        "node_dim": 64,
        "depth": 1,
        "attention_units": 32,
        "attention_heads_num": 10,
        "attention_heads_concat": false,
        "node_pooling": "mean",
        "output_units": [
          64,
          32
        ],
        "num_targets": 7,
        "output_embedding": "node"
      }
    },
    "training": {
      "fit": {
        "epochs": 250,
        "batch_size": 1,
        "early_stopping_patience": 50
      },
      "compile": {
        "optimizer": {
          "class_name": "Adam",
          "config": {
            "lr": 0.001
          }
        },
        "loss": "categorical_crossentropy"
      },
      "scheduler": {
        "class_name": "ReduceLROnPlateau",
        "patience": 25,
        "factor": 0.5,
        "min_lr": 0.0001
      },
      "cross_validation": {
        "n_splits": 5,
        "shuffle": true
      }
    },
    "data": {
      "dataset": {
        "class_name": "CoraLu",
        "config": {
          "root": "data/"
        }
      },
      "data_unit": ""
    }
  },
