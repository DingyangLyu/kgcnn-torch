{
  "SchNet": {
    "model": {
      "config": {
        "model_name": "SchNet",
        "num_features": 256,
        "num_filters": 256,
        "num_interactions": 6,
        "cutoff": 5.0,
        "num_gaussians": 50,
        "readout": "sum",
        "output_dim": 1
      }
    },
    "training": {
      "fit": {
        "epochs": 1000,
        "batch_size": 32,
        "early_stopping_patience": 100,
        "energy_key": "y",
        "force_key": "force"
      },
      "compile": {
        "optimizer": {"class_name": "Adam", "config": {"lr": 5e-4}},
        "loss": "energy_force",
        "energy_weight": 1.0,
        "force_weight": 100.0
      },
      "scheduler": {
        "class_name": "ReduceLROnPlateau",
        "patience": 50,
        "factor": 0.5,
        "min_lr": 1e-7
      },
      "cross_validation": {
        "n_splits": 3,
        "shuffle": true
      }
    },
    "data": {
      "dataset": {
        "class_name": "MD17",
        "config": {
          "file_path": "data/md17_ethanol.kgcnn.pickle"
        }
      },
      "data_unit": "kcal/mol"
    }
  },
